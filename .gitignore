# Data roots if the pipeline is ever run inside the repository
data/
results/figures/
raw/
*.rds
*.RData
*.soft
*.soft.gz

# ---------------------------------------------------------------
# Large intermediate result tables
# Probe-level DMP tables exceed 460 MB in total and are regenerated
# by the pipeline from public GEO inputs. Keep only the summary tables.
# ---------------------------------------------------------------
results/tables/gse231574_DMP_*.csv
results/tables/gse179458_DMP_*.csv
results/tables/gse235267_DE_*.csv
!results/tables/gse231574_DMR_Mal_vs_Ben.csv

# DEPRECATED / MISLEADING — do not publish.
# The legacy "Trend" contrast was written as
#     (borderline - benign) + (malignant - borderline)
# which is algebraically identical to malignant - benign, so these files are
# byte-identical duplicates of the pairwise tables and carry no independent
# evidence. The genuine ordinal model lives in
#     results/tables/gse78071_DE_ordinal_trend*.csv
# Publishing the duplicates invites exactly the misinterpretation we removed
# from the manuscript.
results/tables/*_Trend.csv

