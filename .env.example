# Example configuration for the Phyllodes tumor multi-omics pipeline.
#
# Copy this file to `.env` and edit the two paths below.
# `.env` itself is git-ignored because paths are machine-specific.

# ---------------------------------------------------------------
# Dataset root: raw GEO downloads, processed intermediates and
# all result tables live under this directory.
# Expected sub-directories: raw/  data/processed/  results/tables/  results/figures/
# ---------------------------------------------------------------
DATASET_PATH='E:\path\to\Phyllodes tumor'

# ---------------------------------------------------------------
# Scratch area for temporary / intermediate data.
# May be created on demand by the scripts.
# ---------------------------------------------------------------
DATASET_PATH_TEMP='F:\path\to\temp'

# ---------------------------------------------------------------
# Proxy (only needed when downloading from GEO in a restricted network)
# ---------------------------------------------------------------
DATA_PROXY_TYPE=SOCKS5
DATA_PROXY_HOST=127.0.0.1
DATA_PROXY_PORT_FIRST=1080
DATA_PROXY_PORT_SECOND=1081
